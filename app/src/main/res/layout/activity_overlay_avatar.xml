<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overlayAvatarRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/themeBg">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_jarvis_icon_square"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            app:tint="?attr/themeTextPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dynamic Overlay Avatar"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live companion, color gating, and island"
                android:textColor="?attr/themeTextMuted"
                android:textSize="11.5sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTopSave"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="SAVE"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="19dp"
            android:backgroundTint="?attr/themeAccent"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Scrollable Settings Container -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/settingsScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="36dp">

            <!-- Card 1: Interactive Live Avatar Preview -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="?attr/themeCardBg"
                app:strokeColor="?attr/themeCardBorder"
                app:strokeWidth="1dp"
                app:cardCornerRadius="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LIVE AVATAR PREVIEW"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="10.5sp"
                        android:letterSpacing="0.08"
                        android:textStyle="bold" />

                    <!-- Native 60 FPS View Preview -->
                    <FrameLayout
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="12dp">

                        <com.jarvis.assistant.ui.agent.DynamicOverlayAvatarView
                            android:id="@+id/previewAvatarView"
                            android:layout_width="92dp"
                            android:layout_height="92dp"
                            android:layout_gravity="center" />
                    </FrameLayout>

                    <!-- Preview State Switcher -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Test State:"
                            android:textColor="?attr/themeTextMuted"
                            android:textSize="11sp" />

                        <Spinner
                            android:id="@+id/spinnerPreviewState"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:spinnerMode="dropdown" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Choose Avatar Gallery (Tap to instantly select) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="?attr/themeCardBg"
                app:strokeColor="?attr/themeCardBorder"
                app:strokeWidth="1dp"
                app:cardCornerRadius="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="CHOOSE AVATAR"
                            android:textColor="?attr/themeTextPrimary"
                            android:textStyle="bold"
                            android:textSize="13.5sp"
                            android:letterSpacing="0.04" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tap to apply instantly"
                            android:textColor="?attr/themeAccent"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:layout_marginBottom="10dp"
                        android:text="Select any character below. The selected avatar applies immediately."
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="11sp" />

                    <WebView
                        android:id="@+id/avatarGallery"
                        android:layout_width="match_parent"
                        android:layout_height="320dp"
                        android:background="@android:color/transparent"
                        android:overScrollMode="never" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Avatar Size Adjustment Slider (MetaMuse Screenshot Layout) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="?attr/themeCardBg"
                app:strokeColor="?attr/themeCardBorder"
                app:strokeWidth="1dp"
                app:cardCornerRadius="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Avatar Size"
                        android:textColor="?attr/themeTextPrimary"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_jarvis_icon_square">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_user_profile"
                                app:tint="?attr/themeAccent"
                                android:contentDescription="Avatar size icon" />
                        </FrameLayout>

                        <SeekBar
                            android:id="@+id/seekBarAvatarSize"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:max="100"
                            android:progress="50"
                            android:progressTint="?attr/themeAccent"
                            android:thumbTint="?attr/themeAccent" />

                        <TextView
                            android:id="@+id/tvAvatarSizePercent"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:text="100%"
                            android:textColor="?attr/themeAccent"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:gravity="end" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Drag the slider to adjust the avatar size (Works in all states)"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="11sp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Appearance & Style -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="?attr/themeCardBg"
                app:strokeColor="?attr/themeCardBorder"
                app:strokeWidth="1dp"
                app:cardCornerRadius="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Appearance &amp; Animation"
                        android:textColor="?attr/themeTextPrimary"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <!-- Avatar Style -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Avatar Style"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="11.5sp"
                        android:layout_marginTop="10dp" />

                    <Spinner
                        android:id="@+id/spinnerAvatarStyle"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:entries="@array/avatar_styles"
                        android:spinnerMode="dropdown" />

                    <!-- Animation Speed -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Animation Speed"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="11.5sp"
                        android:layout_marginTop="8dp" />

                    <Spinner
                        android:id="@+id/spinnerAnimationSpeed"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:entries="@array/animation_speeds"
                        android:spinnerMode="dropdown" />

                    <!-- Color Theme -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Color Theme"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="11.5sp"
                        android:layout_marginTop="8dp" />

                    <Spinner
                        android:id="@+id/spinnerColorTheme"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:entries="@array/color_themes"
                        android:spinnerMode="dropdown" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Visual Effects & Audio Waveform -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="?attr/themeCardBg"
                app:strokeColor="?attr/themeCardBorder"
                app:strokeWidth="1dp"
                app:cardCornerRadius="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Visual Effects &amp; Waveform"
                        android:textColor="?attr/themeTextPrimary"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchParticleAnimation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="Particle Animation"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13.5sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAudioWaveform"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="Audio Waveform"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13.5sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchShowStatusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="Show Status Text"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13.5sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchReduceMotion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="Reduce Motion"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13.5sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 4: Audio & Haptic Feedback -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="?attr/themeCardBg"
                app:strokeColor="?attr/themeCardBorder"
                app:strokeWidth="1dp"
                app:cardCornerRadius="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sound &amp; Haptics"
                        android:textColor="?attr/themeTextPrimary"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchAudioFeedback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="Audio Feedback (State Chimes)"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Plays subtle state sound effects without disrupting voice conversations."
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="11sp" />

                    <!-- Sound Profile Selection -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sound Profile / Pack"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="11.5sp"
                        android:layout_marginTop="10dp" />

                    <Spinner
                        android:id="@+id/spinnerSoundProfile"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:entries="@array/sound_profiles"
                        android:spinnerMode="dropdown" />

                    <!-- Live Sound Preview System -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Test &amp; Preview Sounds"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="11sp"
                        android:layout_marginTop="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPreviewIdle"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="Idle"
                            android:textSize="10.5sp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:layout_marginEnd="4dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPreviewWorking"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="Work"
                            android:textSize="10.5sp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:layout_marginEnd="4dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPreviewSpeaking"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="Speak"
                            android:textSize="10.5sp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:layout_marginEnd="4dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPreviewSuccess"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="Success"
                            android:textSize="10.5sp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/themeCardBorder"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="4dp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchHapticFeedback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="Haptic Feedback"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gentle tactile vibration ticks on task state changes."
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 5: Overlay & Dynamic Island Behavior -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/themeCardBg"
                app:strokeColor="?attr/themeCardBorder"
                app:strokeWidth="1dp"
                app:cardCornerRadius="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Overlay &amp; Dynamic Island"
                        android:textColor="?attr/themeTextPrimary"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchOverlayEnabled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="Show Floating Overlay Avatar"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13.5sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchDynamicIsland"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="Dynamic Island (Fixed at Camera Notch)"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Anchored under the front camera punch hole with live waveforms and controls."
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="11sp"
                        android:paddingBottom="6dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/themeCardBorder"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Avatar Display Mode"
                        android:textColor="?attr/themeTextPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/radioOverlayMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <RadioButton
                            android:id="@+id/rbOverlayWorking"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="While Working"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="12sp" />

                        <RadioButton
                            android:id="@+id/rbOverlayAlways"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Always On"
                            android:textColor="?attr/themeTextPrimary"
                            android:textSize="12sp" />
                    </RadioGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Preferred Dock Edge"
                        android:textColor="?attr/themeTextMuted"
                        android:textSize="11.5sp"
                        android:layout_marginTop="10dp" />

                    <Spinner
                        android:id="@+id/spinnerOverlayEdge"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:entries="@array/overlay_edges"
                        android:spinnerMode="dropdown" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Prominent Primary Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="SAVE SETTINGS"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                app:cornerRadius="27dp"
                android:backgroundTint="?attr/themeAccent"
                android:textColor="#FFFFFF"
                android:elevation="4dp" />

            <!-- Status message feedback text -->
            <TextView
                android:id="@+id/tvSaveFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="10dp"
                android:visibility="gone"
                android:textColor="?attr/themeAccent"
                android:textSize="12.5sp"
                android:textStyle="bold" />


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
